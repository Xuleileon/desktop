#!/usr/bin/env bash
# browser-harness-js — eval JS in the persistent CDP REPL. Auto-starts the REPL on first use.
#
# Usage:
#   browser-harness-js 'await session.connect({port:9222})'
#   browser-harness-js 'await session.Page.navigate({url:"https://example.com"})'
#   browser-harness-js <<'EOF'
#     const t = await listPageTargets("localhost", 9222);
#     globalThis.tid = t[0].targetId;
#     await session.use(globalThis.tid);
#     globalThis.tid
#   EOF
#
#   browser-harness-js --status   # is the REPL running? prints health JSON
#   browser-harness-js --stop     # gracefully shut it down
#   browser-harness-js --logs     # tail the REPL log
#   browser-harness-js --restart  # stop + start fresh (drops session state)
#   browser-harness-js --start    # explicit start (no-op if already running)

set -euo pipefail

PORT="${CDP_REPL_PORT:-9876}"
HOST="127.0.0.1"
URL="http://$HOST:$PORT"
EXPECTED_SESSION="${BU_SESSION_ID:-unknown}"
EXPECTED_TARGET="${BU_TARGET_ID:-}"

# Resolve repl.ts alongside this script, following symlinks (e.g. /usr/local/bin/browser-harness-js → <skill-dir>/sdk/browser-harness-js).
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
REPL="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)/repl.ts"

LOG="${CDP_REPL_LOG:-/tmp/browser-harness-js.log}"
PID_FILE="${CDP_REPL_PID_FILE:-$LOG.pid}"

EVAL_TIMEOUT_MS="${CDP_EVAL_TIMEOUT_MS:-60000}"
case "$EVAL_TIMEOUT_MS" in
  ''|*[!0-9]*) EVAL_TIMEOUT_MS=60000 ;;
esac
if (( EVAL_TIMEOUT_MS < 100 || EVAL_TIMEOUT_MS > 120000 )); then
  EVAL_TIMEOUT_MS=60000
fi
HTTP_TIMEOUT_SECONDS="${CDP_REPL_HTTP_TIMEOUT_SECONDS:-$(( (EVAL_TIMEOUT_MS + 999) / 1000 + 10 ))}"
case "$HTTP_TIMEOUT_SECONDS" in
  ''|*[!0-9]*) HTTP_TIMEOUT_SECONDS=70 ;;
esac
if (( HTTP_TIMEOUT_SECONDS < 2 || HTTP_TIMEOUT_SECONDS > 180 )); then
  HTTP_TIMEOUT_SECONDS=70
fi

# Bootstrap bun if missing — the REPL server is Bun-native.
ensure_bun() {
  if command -v bun >/dev/null 2>&1; then return 0; fi
  # Handle fresh install: bun's install script drops the binary here but
  # PATH isn't updated until the next login shell.
  if [ -x "$HOME/.bun/bin/bun" ]; then
    export PATH="$HOME/.bun/bin:$PATH"
    return 0
  fi
  if [ -n "${BROWSER_HARNESS_SKIP_BUN_INSTALL:-}" ]; then
    echo "browser-harness-js: bun not found and BROWSER_HARNESS_SKIP_BUN_INSTALL is set." >&2
    echo "  Install manually: curl -fsSL https://bun.sh/install | bash" >&2
    return 1
  fi
  echo "browser-harness-js: installing bun (one-time, from https://bun.sh/install)..." >&2
  if ! curl -fsSL --connect-timeout 10 --max-time 120 https://bun.sh/install | bash >&2; then
    echo "browser-harness-js: bun install failed. Install manually from https://bun.sh, or set BROWSER_HARNESS_SKIP_BUN_INSTALL=1 to suppress this prompt." >&2
    return 1
  fi
  export PATH="$HOME/.bun/bin:$PATH"
  command -v bun >/dev/null 2>&1 || {
    echo "browser-harness-js: bun installed but not found at \$HOME/.bun/bin/bun." >&2
    return 1
  }
}

is_up() {
  curl -fsS --connect-timeout 1 --max-time 1 "$URL/health" >/dev/null 2>&1
}

health_matches_owner() {
  local health max_time="${1:-1}"
  health=$(curl -fsS --connect-timeout "$max_time" --max-time "$max_time" "$URL/health" 2>/dev/null) || return 1
  printf '%s' "$health" | grep -Fq "\"resourceSessionId\":\"$EXPECTED_SESSION\"" || return 1
  printf '%s' "$health" | grep -Fq "\"targetId\":\"$EXPECTED_TARGET\"" || return 1
}

ownership_error() {
  echo "browser-harness-js: REPL ownership mismatch on $URL; refusing to reuse another conversation's browser runtime." >&2
}

terminate_repl_process() {
  local pid=""
  if [ -f "$PID_FILE" ]; then
    IFS= read -r pid < "$PID_FILE" || true
  fi
  case "$pid" in
    ''|*[!0-9]*) rm -f "$PID_FILE"; return 0 ;;
  esac
  if kill -0 "$pid" >/dev/null 2>&1; then
    kill "$pid" >/dev/null 2>&1 || true
    for _ in $(seq 1 20); do
      kill -0 "$pid" >/dev/null 2>&1 || break
      sleep 0.05
    done
    kill -9 "$pid" >/dev/null 2>&1 || true
  fi
  rm -f "$PID_FILE"
}

start_repl() {
  if is_up; then
    if health_matches_owner; then return 0; fi
    ownership_error
    return 1
  fi
  ensure_bun || return 1
  CDP_REPL_PORT="$PORT" BU_SESSION_ID="$EXPECTED_SESSION" BU_TARGET_ID="$EXPECTED_TARGET" \
    nohup bun "$REPL" "--resource-session=$EXPECTED_SESSION" "--resource-port=$PORT" >"$LOG" 2>&1 &
  printf '%s\n' "$!" > "$PID_FILE"
  for _ in $(seq 1 40); do
    sleep 0.1
    health_matches_owner 0.2 && return 0
  done
  echo "browser-harness-js: REPL failed to start on $URL (see $LOG)" >&2
  terminate_repl_process
  return 1
}

post_eval() {
  # Capture body + status separately. Body goes to stdout (only if non-empty)
  # on 200; otherwise to stderr with non-zero exit.
  local out status body curl_status
  set +e
  out=$(curl -sS --connect-timeout 2 --max-time "$HTTP_TIMEOUT_SECONDS" -w '\n___STATUS___%{http_code}' --data-binary "$1" "$URL/eval")
  curl_status=$?
  set -e
  if [ "$curl_status" -ne 0 ]; then
    echo "browser-harness-js: REPL request failed or timed out after ${HTTP_TIMEOUT_SECONDS}s; recycling the per-conversation REPL." >&2
    terminate_repl_process
    return 1
  fi
  status="${out##*___STATUS___}"
  body="${out%$'\n'___STATUS___*}"
  if [ "$status" = "200" ]; then
    [ -n "$body" ] && printf '%s\n' "$body"
    return 0
  else
    [ -n "$body" ] && printf '%s\n' "$body" >&2
    [ "$status" = "504" ] && terminate_repl_process
    return 1
  fi
}

case "${1:-}" in
  --status)
    if health_matches_owner; then
      curl -sS --connect-timeout 1 --max-time 2 "$URL/health"; echo
    elif is_up; then
      ownership_error
      echo '{"ok":false,"error":"ownership_mismatch"}'
      exit 1
    else
      echo '{"ok":false,"error":"down"}'
      exit 1
    fi
    ;;
  --start)
    start_repl
    curl -sS --connect-timeout 1 --max-time 2 "$URL/health"; echo
    ;;
  --stop)
    if health_matches_owner; then
      curl -s --connect-timeout 1 --max-time 2 -X POST "$URL/quit" >/dev/null || true
      rm -f "$PID_FILE"
      echo '{"ok":true,"stopped":true}'
    elif is_up; then
      ownership_error
      echo '{"ok":false,"error":"ownership_mismatch"}'
      exit 1
    else
      echo '{"ok":true,"stopped":false,"note":"already down"}'
    fi
    ;;
  --restart)
    if is_up && ! health_matches_owner; then ownership_error; exit 1; fi
    is_up && curl -s --connect-timeout 1 --max-time 2 -X POST "$URL/quit" >/dev/null 2>&1 || true
    rm -f "$PID_FILE"
    sleep 0.2
    start_repl
    curl -sS --connect-timeout 1 --max-time 2 "$URL/health"; echo
    ;;
  --logs)
    exec tail -f "$LOG"
    ;;
  --help|-h)
    sed -n '2,/^set -euo/p' "$0" | sed 's/^#//; s/^ //; /^set -euo/d'
    ;;
  "")
    start_repl
    code="$(cat)"
    post_eval "$code"
    ;;
  *)
    start_repl
    post_eval "$1"
    ;;
esac
